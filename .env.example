# Base de données
POSTGRES_USER=covid
POSTGRES_PASSWORD=covid
POSTGRES_DB=covid

# API (port 5000)
API_PORT=5000
DATABASE_URL=postgresql://covid:covid@db:5433/covid
# Source des données JHU CSSE
JHU_BASE_URL=https://raw.githubusercontent.com/CSSEGISandData/COVID-19/master
# Fréquence de synchronisation (cron)
SYNC_CRON=0 3 * * *

# Web (port 3000)
WEB_PORT=3000
# URL de l'API vue depuis le navigateur
NEXT_PUBLIC_API_URL=http://localhost:5000
# URL de l'API vue depuis le conteneur web (SSR)
API_INTERNAL_URL=http://api:5000
