# Format attendu : "type: (scope) message" ou "type(scope): message"
# ex. "feat: (api) add /api/summary endpoint", "build(deps): bump eslint"
types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
first_line=$(head -n 1 "$1")

case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s' "$first_line" | grep -Eq "^($types)(\([a-z0-9-]+\))?: (\([a-z0-9-]+\) ?)?.+"; then
  echo "Message de commit invalide : \"$first_line\""
  echo "Format attendu : type: (scope) message   (types : $types)"
  exit 1
fi
